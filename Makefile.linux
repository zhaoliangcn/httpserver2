# Makefile for testhttpserver2 (Linux version)

# Compiler and flags
CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -I../boost_1_86_0_install/include -I../openssl-3.1.0/include -O2 -I../thirdparty/yaml-cpp/include/
LDFLAGS = -L../boost_1_86_0_install/lib -L../openssl-3.1.0/lib -L../thirdparty/yaml-cpp/build -Wl,-rpath,'$$ORIGIN' -Wl,-rpath,../openssl-3.1.0/lib -Wl,-rpath,../boost_1_86_0_install/lib -lboost_system -lboost_thread -lpthread -lssl -lcrypto -lyaml-cpp -lz

# Target names
TARGET = httpserver2
TEST_TARGET = test_concurrent

# Source files
SERVER_SRCS = httpserver2.cpp main.cpp
TEST_SRCS = httpserver2.cpp test_concurrent.cpp

# Object files
SERVER_OBJS = $(SERVER_SRCS:.cpp=.o)
TEST_OBJS = httpserver2.o test_concurrent.o

# Default target
all: $(TARGET)

# Build both server and test
full: $(TARGET) $(TEST_TARGET)

# Link the main server
$(TARGET): $(SERVER_OBJS)
	$(CXX) $(SERVER_OBJS) -o $(TARGET) $(LDFLAGS)

# Link the test program
$(TEST_TARGET): $(TEST_OBJS)
	$(CXX) $(TEST_OBJS) -o $(TEST_TARGET) $(LDFLAGS)

# Compile source files
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Clean up
clean:
	rm -f $(SERVER_OBJS) $(TEST_OBJS) $(TARGET) $(TEST_TARGET)

# Rebuild
rebuild: clean all

# Rebuild everything including test
rebuild_all: clean full

# Copy dependencies (Linux version)
libs:
	# Copy libraries if needed
	mkdir -p lib
	cp -f ../boost_1_86_0_install/lib/libboost_system.so* lib/
	cp -f ../boost_1_86_0_install/lib/libboost_thread.so* lib/
	cp -f ../openssl-3.1.0/lib/libssl.so* lib/
	cp -f ../openssl-3.1.0/lib/libcrypto.so* lib/

# Phony targets
.PHONY: all clean rebuild libs full rebuild_all
